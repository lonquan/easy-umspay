# ============================================
# 银联商务支付 SDK 环境配置示例
# ============================================
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 填写实际的配置信息
# 3. .env 文件会被 .gitignore 忽略，不会被提交到版本库
# ============================================

# ============================================
# 日志配置
# ============================================
# 是否启用日志：true | false
UMS_LOG_ENABLED=true

# 日志通道：single | daily | stderr | stack
UMS_LOG_CHANNEL=daily

# 日志路径（使用绝对路径或相对于项目根目录的路径）
UMS_LOG_PATH=./logs/umspay.log

# 日志级别：debug | info | notice | warning | error | critical | alert | emergency
UMS_LOG_LEVEL=debug

# 日志保留天数（仅对 daily 通道有效）
UMS_LOG_DAYS=7

# HTTP 请求/响应日志开关（默认全部关闭）
UMS_LOG_HTTP_REQUEST=false
UMS_LOG_HTTP_RESPONSE=false
UMS_LOG_HTTP_BODY=false

# ============================================
# HTTP 配置（Symfony HttpClient 选项）
# ============================================
UMS_HTTP_TIMEOUT=10
UMS_HTTP_MAX_DURATION=30
UMS_HTTP_VERIFY_PEER=true
UMS_HTTP_VERIFY_HOST=true

# SDK 专有：访问响应时是否抛 HTTP 异常
UMS_HTTP_THROW=true

# ============================================
# 自助签约配置（商户入网、信息变更等）
# ============================================
# API 基础地址
# 测试环境: https://selfapply-test.chinaums.com
# 生产环境: https://yinshangpai.chinaums.com
UMS_SELF_CONTRACT_BASE_URL=https://selfapply-test.chinaums.com

# 接入方 ID（由银联商务提供）
UMS_SELF_CONTRACT_ACCESSER_ID=your_accesser_id_here

# 签名密钥（24 字节，由银联商务提供）
# 用于 3DES 加密敏感字段和 SHA256 签名
UMS_SELF_CONTRACT_SIGN_KEY=123456789012345678901234

# ============================================
# 交易配置（新购物车 / 老购物车）
# ============================================
# 协议：shopping_cart（新购物车）| netpay（老购物车）
UMS_TRADE_PROTOCOL=shopping_cart

# API 基础地址
# 新购物车测试环境: https://test-api-open.chinaums.com
# 新购物车生产环境: https://api-mop.chinaums.com
UMS_TRADE_BASE_URL=https://test-api-open.chinaums.com

# 应用 ID / 应用密钥（由银联商务提供）
UMS_TRADE_APP_ID=your_app_id_here
UMS_TRADE_APP_KEY=your_app_key_here

# 商户号 / 终端号（由银联商务提供）
UMS_TRADE_MERCHANT_NO=your_merchant_no_here
UMS_TRADE_TERMINAL_NO=your_terminal_no_here

# 可选：报文中 msgSrc 来源标识
UMS_TRADE_MESSAGE_SOURCE=

# 可选：业务类型覆盖；缺省按支付场景推导
UMS_TRADE_INST_MID=
